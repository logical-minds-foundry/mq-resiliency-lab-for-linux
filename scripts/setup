#!/usr/bin/env bash
# scripts/setup — prepare the Python environment so `mqlab` runs, then point the
# operator at lab bring-up. This sets up the ENVIRONMENT only; it does NOT bring
# the lab up (that is `mqlab bootstrap <setup>`).
#
# Targets macOS and Linux. Assumes you can install host packages (root/sudo) on a
# virtualization-capable host; `mqlab doctor` checks the host itself.
set -euo pipefail

die() { echo "setup: $*" >&2; exit 1; }

# 1. Prerequisite checks (fail loud, no silent fallback).
command -v uv >/dev/null 2>&1 || die "uv not found — install it: https://docs.astral.sh/uv/getting-started/installation/"

# Run from the repo root, whatever the caller's cwd.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# The lab depends on a uv-MANAGED interpreter, never the base OS Python
# (pyproject [tool.uv] only-managed, #1063). The version is not pinned in the
# repo (it follows Vergil's version window, #1681); the floor is the
# `requires-python` lower bound in pyproject.toml, so read it from there rather
# than repeating a version here. If uv can't already find a managed interpreter
# at that version, install one — don't die: uv downloads and manages its own
# build, so this needs no host Python upgrade.
PYTHON_FLOOR=$(sed -n 's/^requires-python = ">=\([0-9][0-9.]*\)"$/\1/p' pyproject.toml)
[ -n "${PYTHON_FLOOR}" ] || die "cannot read the Python floor from pyproject.toml (expected: requires-python = \">=X.Y\")"
if ! uv python find "${PYTHON_FLOOR}" >/dev/null 2>&1; then
    echo "setup: uv-managed Python ${PYTHON_FLOOR} not found — installing it (uv python install ${PYTHON_FLOOR})…"
    uv python install "${PYTHON_FLOOR}" || die "Python ${PYTHON_FLOOR} install failed — install it by hand: 'uv python install ${PYTHON_FLOOR}'"
fi

# 2. Materialize the environment.
echo "setup: syncing the Python environment (uv sync)…"
uv sync

# 3. Point the operator at the next steps.
cat <<'NEXT'

setup: environment ready.

Next steps:
  1. Pre-flight the host:      mqlab doctor
  2. Bring up a setup:         mqlab bootstrap <setup>     (e.g. distributed-pcmk-ubuntu)

Run mqlab via the synced environment, e.g.:
  uv run mqlab doctor
  uv run mqlab bootstrap distributed-pcmk-ubuntu

(Or activate the venv: '. .venv/bin/activate' then 'mqlab ...'.)
NEXT
