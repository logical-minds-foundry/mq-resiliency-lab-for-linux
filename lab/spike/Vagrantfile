# lab/spike/Vagrantfile — Phase A provider spike (temporary).
Vagrant.configure("2") do |config|
  config.vm.define "spike-arm64" do |m|
    m.vm.box = "cloud-image/ubuntu-24.04"   # candidate 1; see plan Task 2 Step 2
    m.vm.network :private_network,
      :libvirt__network_name => "net-hb-a",
      :ip => "172.16.1.11",
      :libvirt__dhcp_enabled => false
    m.vm.provider :libvirt do |lv|
      lv.driver = "kvm"
      lv.cpus   = 1
      lv.memory = 1024
      # arm64 guests boot via UEFI (AAVMF); libvirt rejects the domain
      # without it ("ACPI requires UEFI on this architecture"). See #20.
      # NOTE: vagrant-libvirt emits the loader as type='pflash' (UEFI)
      # only when nvram is ALSO set — loader alone is emitted as
      # type='rom' and libvirt still refuses (plugin domain.xml.erb:80-86).
      # libvirt creates the per-domain NVRAM from the AAVMF template via
      # its firmware descriptors.
      lv.loader = "/usr/share/AAVMF/AAVMF_CODE.fd"
      lv.nvram  = "/var/lib/libvirt/qemu/nvram/spike-arm64_VARS.fd"
      # arm64 virt machines have no PS/2 (plugin default) and no USB
      # controller; virtio input needs neither.
      lv.input :type => "mouse", :bus => "virtio"
      # aarch64 KVM rejects the plugin-default cpu_mode host-model;
      # passthrough is the supported (and fastest) mode.
      lv.cpu_mode = "host-passthrough"
    end
  end

  config.vm.define "spike-x86", autostart: false do |m|
    # debian/bookworm64: lean enough to reach DHCP inside vagrant-libvirt's
    # HARDCODED 600s IP-wait cap (wait_till_up.rb tries:300 x 2s — ignores
    # boot_timeout). almalinux/9 under TCG boots healthily but needs >10min
    # to DHCP (EL9 cloud-init + SELinux relabel) and trips the cap — a real
    # constraint for the Phase C RDQM/RHEL arm, recorded in the spike report.
    m.vm.box = "debian/bookworm64"
    m.vm.provider :libvirt do |lv|
      lv.driver       = "qemu"              # TCG — no KVM for cross-arch
      lv.machine_arch = "x86_64"            # plugin option is machine_arch, not arch
      lv.machine_type = "q35"
      # Cross-arch TCG cannot use host-model (the host CPU is aarch64);
      # pin an explicit x86-64 model.
      lv.cpu_mode  = "custom"
      lv.cpu_model = "qemu64"
      lv.cpus         = 4                   # MTTCG parallelizes; help the boot
      lv.memory       = 2048
    end
    m.vm.boot_timeout = 1800                # TCG boots are minutes, not seconds
  end
end
