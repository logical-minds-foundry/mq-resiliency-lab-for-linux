# lab/secret-names — the registry of secret names lab/scripts/lab-secret.sh may
# mint (#1570). One name per line; `#` starts a comment line. lab-secret.sh
# refuses any name not listed here, so a caller typo fails loudly instead of
# silently minting a fresh secret the lab was never provisioned with.
#
# tests/test_lab_secret.py keeps this file and the callers in lockstep: every
# name a caller uses must be listed, and every listed name must have a caller.
# Add a name here in the same change that adds its caller.

# --- fixed names -----------------------------------------------------------------
# Stack `secrets:` in lab/topology.yaml, injected by `mqlab bootstrap`
# (src/mqlab/cli.py _source_secret); also lab/scripts/dr-provision.sh.
pcmk_hacluster_password
mqweb_admin_password
# ansible/roles/opensearch-dashboards/tasks/configure.yml
opensearch_admin_password

# --- PKI keystore passwords: pki-keyrpwd-<cn lowercased> -----------------------------
# One per *personal* PKI entity (trust_only entities have no keystore). The entity
# list is derived from the topology (src/mqlab/cli.py _render_pki_entities): each
# stack's <short>APP, the shared svc counterparty <svc short>QM, and the fixed
# non-QM entities. Minted by ansible/roles/lab-pki/tasks/entity.yml and read back
# by ansible/roles/mq-nativeha/tasks/tls.yml and ansible/roles/pki-distribute.
# A new or renamed stack/entity must be listed here (the test enforces equality).
pki-keyrpwd-pcmkapp
pki-keyrpwd-rdqmapp
pki-keyrpwd-nharcapp
pki-keyrpwd-nhauapp
pki-keyrpwd-svcqm
pki-keyrpwd-app-client
pki-keyrpwd-mq_prometheus
pki-keyrpwd-mqweb
pki-keyrpwd-svc-responder
