# lab/Vagrantfile — multi-machine lab driven by mqlab's host-resolved topology (#276).
#
# Provider mechanics (driver/firmware/cpu_mode) are chosen by mqlab's resolver from
# the host architecture and rendered to build/work/lab/topology.resolved.yaml. This file
# is a dumb consumer: it applies fields verbatim. Box-version pins still come from
# build/work/box-versions.json (#266).
require "yaml"
require "json"

resolved = File.join(__dir__, "..", "build", "work", "lab", "topology.resolved.yaml")
unless File.exist?(resolved)
  raise "resolved topology missing: #{resolved}\n" \
        "Run `mqlab vm up` / `mqlab vm create` (or `mqlab vm render`) first — they " \
        "render it from lab/topology.yaml + host facts."
end
nodes = YAML.load_file(resolved).fetch("nodes")

# Manifest-driven box_version pins (#266), keyed by platform. Absent the file
# (no manifest), boxes float exactly as before.
bvf = File.join(__dir__, "..", "build", "work", "box-versions.json")
box_versions = File.exist?(bvf) ? JSON.parse(File.read(bvf)) : {}

Vagrant.configure("2") do |config|
  # No /vagrant synced folder anywhere: Ansible owns file transport, and the rsync
  # fallback needs guest-side package installs the offline RHEL box cannot perform.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # All guests share Vagrant's insecure key so the rendered inventory carries one
  # constant key path instead of N scraped per-machine paths (#101).
  config.ssh.insert_key = false

  nodes.each do |name, n|
    config.vm.define name do |node|
      node.vm.box      = n.fetch("box")
      bv = box_versions[n.fetch("platform")]
      node.vm.box_version = bv if bv
      node.vm.hostname = name
      node.vm.boot_timeout = n["boot_timeout"] if n["boot_timeout"]
      node.vm.provider :libvirt do |lv|
        # VM images use libvirt's default pool (/var/lib/libvirt/images on the boot
        # disk) — ephemeral, wiped on rebuild. The #376 redirect onto the persistent
        # /vergil data disk was reverted (#385): it put wipe-on-rebuild overlays on a
        # never-wiped disk, orphaning volumes and breaking rebuilds. The boot disk is
        # sized to fit instead (vergil-vm#270).
        lv.cpus     = n.fetch("cpus")
        lv.memory   = n.fetch("memory")
        lv.driver   = n.fetch("driver")
        lv.cpu_mode = n.fetch("cpu_mode")
        lv.machine_arch = n["machine_arch"] if n["machine_arch"]
        lv.machine_type = n["machine_type"] if n["machine_type"]
        lv.loader   = n["loader"] if n["loader"]
        lv.nvram    = n["nvram"]  if n["nvram"]
        lv.input(:type => "mouse", :bus => n["input_bus"]) if n["input_bus"]
        # Optional extra data disk (GiB) — e.g. the RDQM drbdpool PV.
        lv.storage(:file, :size => "#{n['extra_disk']}G") if n["extra_disk"]
        # Optional platform DVD (offline dnf repo for repo-less guests).
        # bus sata: q35 machines have no IDE controller (plugin default).
        if n["dvd"]
          lv.storage :file, :device => :cdrom, :path => n["dvd"], :bus => "sata"
        end
      end
      (n["nics"] || {}).each do |net, ip|
        node.vm.network :private_network,
          :libvirt__network_name => net,
          :ip => ip,
          :libvirt__dhcp_enabled => false
      end
    end
  end
end
