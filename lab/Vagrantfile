# lab/Vagrantfile — multi-machine lab, driven entirely by topology.yaml.
#
# Arch-specific provider settings were established by the Phase A provider
# spike (docs/reports/2026-06-06-phase-a-provider-spike.md):
#   aarch64 (KVM):  UEFI loader+nvram mandatory (pflash needs BOTH set),
#                   virtio input (no PS/2/USB), cpu host-passthrough.
#   x86_64  (TCG):  machine_arch (not arch), q35, cpu custom/qemu64,
#                   long boot timeout.
require "yaml"

topology = YAML.load_file(File.join(__dir__, "topology.yaml"))
boxes    = topology.fetch("boxes")
defaults = topology.fetch("defaults")

Vagrant.configure("2") do |config|
  # No /vagrant synced folder anywhere: Ansible owns file transport, and
  # the rsync fallback needs guest-side package installs that the
  # repo-less (unregistered, offline) RHEL box cannot perform.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  topology.fetch("nodes").each do |name, spec|
    spec ||= {}
    platform = boxes.fetch(spec.fetch("platform", defaults["platform"]))
    config.vm.define name do |node|
      node.vm.box      = platform.fetch("box")
      node.vm.hostname = name
      node.vm.provider :libvirt do |lv|
        lv.cpus   = spec.fetch("cpus",   defaults["cpus"])
        lv.memory = spec.fetch("memory", defaults["memory"])
        case platform.fetch("arch")
        when "aarch64"
          lv.driver   = "kvm"
          lv.loader   = "/usr/share/AAVMF/AAVMF_CODE.fd"
          lv.nvram    = "/var/lib/libvirt/qemu/nvram/lab-#{name}_VARS.fd"
          lv.input :type => "mouse", :bus => "virtio"
          lv.cpu_mode = "host-passthrough"
        when "x86_64"
          lv.driver       = "qemu"
          lv.machine_arch = "x86_64"
          lv.machine_type = "q35"
          # cpu_mode maximum (= qemu -cpu max) is REQUIRED, not an
          # optimization: EL9 needs x86-64-v2, and sub-v2 models like
          # qemu64 boot the kernel but kill early userspace (glibc HWCAP)
          # in an invisible loop. Diagnosed in #24: same alma9 image,
          # qemu64 = 40min silent spin; maximum = DHCP lease in 47s.
          lv.cpu_mode     = "maximum"
          node.vm.boot_timeout = 1800
        else
          raise "unknown arch for platform: #{platform}"
        end
        # Optional extra data disk (GiB) - e.g. the RDQM drbdpool PV.
        if spec["extra_disk"]
          lv.storage :file, :size => "#{spec['extra_disk']}G"
        end
        # Optional platform DVD (offline dnf repo for repo-less guests).
        # bus sata: q35 machines have no IDE controller (plugin default).
        if platform["dvd"]
          lv.storage :file, :device => :cdrom, :path => platform["dvd"],
                     :bus => "sata"
        end
      end
      spec.fetch("nics", {}).each do |net, ip|
        node.vm.network :private_network,
          :libvirt__network_name => net,
          :ip => ip,
          :libvirt__dhcp_enabled => false
      end
    end
  end
end
