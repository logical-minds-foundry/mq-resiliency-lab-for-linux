apiVersion: 1
providers:
  - name: lab
    type: file
    # Per-stack folders are derived from the on-disk directory tree mqlab renders
    # (#59): each stack's boards under a "<Mechanism> (<OS>)" folder, the Watcher at
    # the root. foldersFromFilesStructure requires folder/folderUid to be unset.
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: true
