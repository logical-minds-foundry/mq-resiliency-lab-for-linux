global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/rules/lab.rules.yml

scrape_configs:
  - job_name: node
    file_sd_configs:
      - files: ["/etc/prometheus/targets/node.json"]

  # mq_prometheus exporters on mon-probe (net-mgmt), client-mode against each QM.
  # Metrics are keyed by qmgr= (not the host), so the panel follows the QM across
  # failover. One exporter pair PER STACK on the topology alloc ports (9157-9164);
  # the target list is rendered per-stack from topology (mqlab scrape, #423) so all
  # per-stack boards can be live at once. A stopped stack's targets just read down.
  - job_name: ibmmq
    file_sd_configs:
      - files: ["/etc/prometheus/targets/ibmmq.json"]

  # Data Prepper's own metrics (#1238): the OpenSearch sink's document counters
  # (logs_pipeline_opensearch_documentErrors_total etc.), so a document OpenSearch
  # rejects is a visible, alertable number instead of two WARN lines in obs's journal.
  # Data Prepper runs on obs beside Prometheus (#1179), so this is a static localhost
  # target, not a topology render. Path: Data Prepper 2.16.0's DataPrepperServer
  # registers the Prometheus scrape handler on /metrics/prometheus (and /metrics/sys).
  - job_name: data-prepper
    metrics_path: /metrics/prometheus
    static_configs:
      - targets: ["{{ prometheus_data_prepper_target }}"]
