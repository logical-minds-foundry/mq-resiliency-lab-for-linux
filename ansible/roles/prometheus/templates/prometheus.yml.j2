global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/rules/lab.rules.yml

scrape_configs:
  - job_name: node
    file_sd_configs:
      - files: ["/etc/prometheus/targets/node.json"]

  # mq_prometheus exporter on mon-probe (net-mgmt), client-mode against the QM
  # VIP. Metrics are keyed by qmgr= (not the host), so the panel follows the QM
  # across failover while the scrape target stays fixed here (#172).
  - job_name: ibmmq
    static_configs:
      - targets: ["10.50.0.3:9157"]
        labels: { host: mon-probe }
