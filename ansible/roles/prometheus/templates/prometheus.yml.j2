global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/rules/lab.rules.yml

scrape_configs:
  - job_name: node
    file_sd_configs:
      - files: ["/etc/prometheus/targets/node.json"]

  # mq_prometheus exporters on mon-probe (net-mgmt), client-mode against each QM.
  # Metrics are keyed by qmgr= (not the host), so the panel follows the QM across
  # failover while the scrape target stays fixed here (#172). One job per QM:
  # PCMKAPP on :9157 (our HA QM), PCMKSVC on :9158 (the SVC counterparty, #182).
  - job_name: ibmmq
    static_configs:
      - targets: ["10.50.0.3:9157"]
        labels: { host: mon-probe }

  - job_name: ibmmq-svc
    static_configs:
      - targets: ["10.50.0.3:9158"]
        labels: { host: mon-probe }
