[Unit]
Description=mq_prometheus exporter — {{ mq_exporter_qm }} (client-mode, #172)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mqm
Group=mqm
Environment=LD_LIBRARY_PATH=/opt/mqm/lib64
{% if mq_exporter_tls | bool %}
# TLS (#250): MQSSLKEYR points at the keystore stem (sibling .sth supplies the
# password). SSLCIPH/cert-label/connName/channel travel in the CCDT the config
# references — no MQ-TLS CLI or YAML flag exists.
Environment=MQSSLKEYR={{ mq_exporter_keyrepo }}
{% endif %}
# Config-file launcher (#944): all connection/object/filter/fire-hose settings live
# in the rendered per-QM YAML — the only clean way to reach EXTENDED and the per-class
# filters (no CLI flag). See mq-exporter.yaml.j2. Launcher stays systemd (off-cluster
# client-mode exporter); the YAML is the portable deliverable.
ExecStart=/usr/local/bin/mq_prometheus -f {{ mq_exporter_config }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
