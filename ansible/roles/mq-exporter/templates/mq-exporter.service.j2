[Unit]
Description=mq_prometheus exporter — {{ mq_exporter_qm }} (client-mode, #172)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mqm
Group=mqm
Environment=LD_LIBRARY_PATH=/opt/mqm/lib64
{% if mq_exporter_tls | bool %}
# TLS (#250): MQSSLKEYR points at the keystore stem (sibling .sth supplies the
# password); the CCDT carries the channel/conn + SSLCIPH + cert label, so connName
# and channel are not passed as flags here.
Environment=MQSSLKEYR={{ mq_exporter_keyrepo }}
ExecStart=/usr/local/bin/mq_prometheus -ibmmq.client -ibmmq.queueManager {{ mq_exporter_qm }} -ibmmq.ccdtUrl "file://{{ mq_exporter_ccdt }}" -ibmmq.monitoredQueues {{ mq_exporter_monitored_queues }} -ibmmq.monitoredChannels {{ mq_exporter_monitored_channels }} -ibmmq.httpListenPort {{ mq_exporter_port }}
{% else %}
ExecStart=/usr/local/bin/mq_prometheus -ibmmq.queueManager {{ mq_exporter_qm }} -ibmmq.connName "{{ mq_exporter_conn }}" -ibmmq.channel {{ mq_exporter_channel }} -ibmmq.monitoredQueues {{ mq_exporter_monitored_queues }} -ibmmq.monitoredChannels {{ mq_exporter_monitored_channels }} -ibmmq.httpListenPort {{ mq_exporter_port }}
{% endif %}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
