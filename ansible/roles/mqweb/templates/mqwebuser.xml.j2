<?xml version="1.0" encoding="UTF-8"?>
<!-- mqweb security (epic .github#341 spec §2.2): IBM's three roles (S8), one sample user per
     role in a basic registry (S10). No anonymous access: the MQ Console and the REST API
     both require a login. Every password in this file is AES-encoded with the server's one
     key, which is included below (S16). Each was encoded once and persisted, so this render
     is stable across re-provisions. LAB ONLY: the human logins use password = username
     (spec §8 D2). -->
<server>
  <featureManager>
    <feature>appSecurity-2.0</feature>
    <feature>basicAuthenticationMQ-1.0</feature>
  </featureManager>
  <include location="{{ mqweb_server_dir }}/aes-key.xml"/>
{% for app in ['com.ibm.mq.console', 'com.ibm.mq.rest'] %}
  <enterpriseApplication id="{{ app }}">
    <application-bnd>
{% for u in mqweb_users %}
      <security-role name="{{ u.role }}">
        <user name="{{ u.name }}" realm="defaultRealm"/>
      </security-role>
{% endfor %}
    </application-bnd>
  </enterpriseApplication>
{% endfor %}
  <basicRegistry id="basic" realm="defaultRealm">
{% for u in mqweb_users %}
    <user name="{{ u.name }}" password="{{ mqweb_encoded_passwords[u.name] }}"/>
{% endfor %}
  </basicRegistry>
  <variable name="httpHost" value="*"/>
{% if mqweb_tls | bool %}
  <!-- TLS (#250): serve the org-CA `mqweb` entity cert over TLS 1.3 instead of
       Liberty's default self-signed cert. serverKeyAlias is the cert label (CN). -->
  <keyStore id="mqwebKeyStore" location="{{ mqweb_security_dir }}/key.p12" type="PKCS12" password="{{ mqweb_encoded_passwords['keystore'] }}"/>
  <ssl id="mqwebSSL" keyStoreRef="mqwebKeyStore" serverKeyAlias="mqweb" sslProtocol="TLSv1.3"/>
  <sslDefault sslRef="mqwebSSL"/>
{% else %}
  <sslDefault sslRef="mqDefaultSSLConfig"/>
{% endif %}
{% if mqweb_json_logging | default(true) | bool %}
  <!-- #282: JSON diagnostic logging to messages.log (tailed into Loki as unit=ibm-mqweb) -->
  <logging messageFormat="json" messageSource="message,ffdc"/>
{% endif %}
</server>
