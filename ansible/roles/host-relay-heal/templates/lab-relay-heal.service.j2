[Unit]
Description=Heal the Grafana port-forward relay if wedged (#946)

[Service]
Type=oneshot
# Call mqlab by absolute path — root's minimal PATH has neither `uv` nor mqlab.
# `mqlab_bin` is the host-runnable console script the observe phase passes in
# (phases._host_mqlab). MQLAB_REPO_ROOT lets mqlab resolve build/ for its transcript.
# `obs relay-heal` probes the workstation-facing forward and restarts the relay ONLY
# when it is wedged (the accept-then-reset fd leak that builds up under sustained use;
# upstream fix vergil-tooling#2603) — a healthy relay is left alone so live Grafana
# sessions are not dropped. A non-zero exit (still wedged after a restart) fails the
# unit loudly; the timer re-fires on the next interval.
Environment=MQLAB_REPO_ROOT={{ repo_root }}
ExecStart={{ mqlab_bin }} obs relay-heal
