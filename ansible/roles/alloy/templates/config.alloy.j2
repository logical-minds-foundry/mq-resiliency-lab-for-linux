// Grafana Alloy: ship the systemd journal to Loki on obs.
// Labels stay low-cardinality (host + unit); the JSON payload is parsed in
// Grafana with `| json`. host is templated from the Ansible inventory name.

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // #282/#516: MQ logs AND events arrive via syslog with no systemd unit. Fill `unit`
  // from the syslog identifier ONLY when systemd_unit is empty, so cluster-daemon units
  // (corosync, pacemaker, drbd) keep their existing `unit` label. MQ core logs arrive as
  // unit="ibm-mq"; the mq-event-monitor collector (#515) tags 'mq-events', so this same
  // rule yields unit="mq-events" — a separate Loki stream from the logs.
  // #742: the syslog identifier field is `__journal_syslog_identifier` — ONE underscore
  // between "journal" and "syslog". Alloy names each journal label `__journal_` + the
  // lowercased field name, so the trusted `_SYSTEMD_UNIT` (leading underscore) becomes
  // `__journal__systemd_unit` (two), but the app-set `SYSLOG_IDENTIFIER` (no leading
  // underscore) becomes `__journal_syslog_identifier` (one). The original two-underscore
  // spelling named a field that never exists, so this fallback silently never fired.
  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    separator     = ";"
    regex         = ";(.+)"
    replacement   = "$1"
    target_label  = "unit"
  }

  // #742: On Native HA the queue manager — and the mq-event-monitor collector (#515),
  // which runs as an MQ SERVICE inside the QM's systemd cgroup — log under the QM's own
  // unit (e.g. mqmonitor@NHARAPP.service), so their journal entries carry a NON-empty
  // _SYSTEMD_UNIT. The systemd_unit-empty fallback above therefore never fires for them
  // and they are mislabeled unit="mqmonitor@<QM>.service" — hiding MQ core logs and the
  // #516 mq-events boards. Force `unit` from the syslog identifier for the known MQ
  // identifiers (ibm-mq core logs, mq-events collector), regardless of the owning systemd
  // unit. Anchored + scoped to just these two identifiers, so cluster-daemon units
  // (corosync, pacemaker, drbd) and ibm-mqweb are untouched; on the non-NHA arms (empty
  // systemd_unit) this restates the same unit value rule 2 sets — idempotent. Uses the
  // one-underscore `__journal_syslog_identifier` (see the field-naming note on rule 2).
  rule {
    source_labels = ["__journal_syslog_identifier"]
    regex         = "(ibm-mq|mq-events)"
    replacement   = "$1"
    target_label  = "unit"
  }
}

loki.source.journal "system" {
  // #831: when the OpenSearch fan-out gate is on, this source keeps forwarding to
  // Loki AND gains a second target — the loki->OTLP bridge below. The Loki path is
  // untouched (transport is a swappable boundary; json-logging principle).
  forward_to    = [loki.write.obs.receiver{% if alloy_fanout_opensearch | default(false) | bool %}, otelcol.receiver.loki.opensearch_bridge.receiver{% endif %}]
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    host = "{{ inventory_hostname }}",
  }
}

loki.write "obs" {
  endpoint {
    url = "{{ loki_push_url }}"
  }
}

{% if alloy_tail_mqweb | default(false) | bool %}
// #282: tail the mqweb (Liberty) JSON messages.log on QM nodes (labelled unit=ibm-mqweb).
local.file_match "mqweb" {
  path_targets = [{
    "__path__" = "/var/mqm/web/installations/Installation1/servers/mqweb/logs/messages.log",
    "host"     = "{{ inventory_hostname }}",
    "unit"     = "ibm-mqweb",
  }]
}

loki.source.file "mqweb" {
  targets    = local.file_match.mqweb.targets
  // #831: same fan-out as the journal source — Loki stays, OpenSearch is additive.
  forward_to = [loki.write.obs.receiver{% if alloy_fanout_opensearch | default(false) | bool %}, otelcol.receiver.loki.opensearch_bridge.receiver{% endif %}]
}
{% endif %}

{% if alloy_fanout_opensearch | default(false) | bool %}
// #831 logsearch fan-out (gating spike #826, docs/reports/2026-07-29-alloy-opensearch-connector-spike.md).
// Alloy has NO native Elasticsearch/OpenSearch exporter, so the "fan-out sink to
// OpenSearch" is an OTLP/gRPC exporter aimed at a Data Prepper otel_logs_source;
// Data Prepper (a separate component on the logsearch node, #830/#832) is what
// writes to OpenSearch. This block ONLY adds a receive/export path — the existing
// loki.source.* blocks above forward here as a second target and the loki.write
// "obs" path is left entirely alone (transport is a swappable boundary).
otelcol.receiver.loki "opensearch_bridge" {   // Loki log entries -> OTLP logs (Alloy-native bridge)
  output {
    logs = [otelcol.exporter.otlp.dataprepper.input]
  }
}

otelcol.exporter.otlp "dataprepper" {          // OTLP/gRPC -> Data Prepper otel_logs_source (logs port 21892)
  client {
    endpoint = "{{ opensearch_dataprepper_endpoint }}"
    tls {
      insecure = true                          // mgmt-plane-only, no TLS in v1 (spec §10)
    }
  }
}
{% endif %}
