#!/bin/bash
# MQ event collector launcher (#515, epic .github#31). Started by the queue manager as
# an MQ SERVICE object (CONTROL(QMGR)), so it travels with the QM across every failover.
#
# `exec` matters: it replaces this shell so the process the QM tracks (MQ_SERVER_PID) IS
# amqsevt. The service's STOPCMD is `kill MQ_SERVER_PID`, so QM shutdown then stops the
# collector cleanly. A naive `amqsevt | logger` would leave the QM tracking the shell and
# ORPHAN the pipeline on stop — the collector would keep draining after the QM went away.
#
# Destructive drain (no -b): amqsevt is the single event consumer; each event processed
# once. No -q → the standard SYSTEM.ADMIN.*.EVENT set. `stdbuf -oL` keeps stdout
# line-buffered so JSON reaches journald promptly. Output → journald tagged
# '{{ mq_event_syslog_tag }}', beside the MQ core logs (tag 'ibm-mq'); when amqsevt exits,
# the logger reader sees EOF and exits too.
#
# `-o json_compact` (NOT `-o json`): logger is line-oriented — one input line becomes one
# journald entry. json_compact emits each event as a single-line JSON object, so logger
# writes exactly one journald entry per event, each entry a complete parseable object.
# Pretty `-o json` spans ~60 lines per event and would be shredded across that many
# entries, none of them valid JSON.
#
# `logger --size {{ mq_event_logger_max_size }}`: json_compact is necessary but NOT sufficient.
# logger's default max message is RFC 3164's 1 KiB and it SPLITS a longer input line into
# multiple entries — so a full CONFIG event (whole-object dump, ~4 KB) would still be shredded
# into ~1 KiB fragments. Raising the size to hold the largest event keeps it one entry, one
# parseable object. (See mq_event_logger_max_size in defaults; proven in the lab.)
#
# $1 is the queue-manager name, passed by the service's STARTARG.
exec stdbuf -oL {{ mq_event_amqsevt_bin }} -m "$1" -o json_compact > >(exec logger --size {{ mq_event_logger_max_size }} -t {{ mq_event_syslog_tag }})
