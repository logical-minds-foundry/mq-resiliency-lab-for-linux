{# mq-app-requester.env — deployer-owned site values for the mq-resiliency-clients
   mq-app-requester.service (EnvironmentFile=; epic .github#294 spec §5.4 r3). TLS_ARGS is
   empty for a plaintext app channel, or the keystore stem + cert label when it is TLS; the
   unit expands it unbraced ($TLS_ARGS), so systemd splits it into words. #}
# Managed by Ansible (role app-requester). Read by mq-app-requester.service.
QM={{ app_requester_qm }}
CONN={{ app_requester_conn }}
CHANNEL={{ app_requester_channel }}
RATE={{ app_requester_rate }}
MSG_SIZE={{ app_requester_msg_size }}
TEXTFILE={{ app_requester_textfile }}
TLS_ARGS={% if app_requester_tls | bool %}--keyrepo {{ app_requester_keyrepo }} --certlabel {{ app_requester_certlabel }}{% endif %}

