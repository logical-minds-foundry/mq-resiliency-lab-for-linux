{# mq-svc-responder.env — deployer-owned site values for the mq-resiliency-clients
   mq-svc-responder@.service (EnvironmentFile=; epic .github#294 spec §5.4 r3). The instance
   (%i) is the stack's request queue; these values are shared by every instance on the one
   SVC QM (#446). The responder is a SVRCONN client to localhost over mutual TLS (#250). #}
# Managed by Ansible (role mq-inter-qm). Read by mq-svc-responder@.service.
QM={{ qmgr_name }}
CHANNEL=SVC.SVRCONN
CONN=localhost(1414)
KEYREPO=/var/mqm/ssl/svc-responder/key
CERTLABEL=svc-responder
