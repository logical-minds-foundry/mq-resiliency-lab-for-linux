[Unit]
Description=DTCC service responder (bindings; QM-to-QM #147)
After=mq-{{ qmgr_name }}.service
Requires=mq-{{ qmgr_name }}.service

[Service]
Type=simple
User=mqm
Group=mqm
Environment=LD_LIBRARY_PATH=/opt/mqm/lib64
ExecStart=/var/mqm/rvenv/bin/python /var/mqm/service_responder.py --qm {{ qmgr_name }} --in-queue SVC.REQUEST
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
