# Managed by ansible/roles/data-prepper (logsearch tier, epic .github#149, issue #939).
# The end-to-end pipeline the connector spike (#826) proved:
#   Alloy --(OTLP/gRPC)--> otel_logs_source --> parse_json --> opensearch sink
#
# Data Prepper reads every *.yaml in its pipelines/ dir; this is the only one.
logs-pipeline:
  source:
    # OTLP logs over gRPC. ssl:false = plaintext, matching Alloy's `tls { insecure = true }`
    # exporter on the lab's mgmt-only telemetry plane (no TLS in v1, spec §10). This is the
    # port #831's Alloy fan-out targets via `opensearch_dataprepper_endpoint`.
    otel_logs_source:
      ssl: false
      port: {{ data_prepper_otel_logs_port }}
  processor:
    # The MQ JSON arrives as a STRING in the OTLP `body` (spike downstream note #2). Parse
    # it and promote its keys (severity, ibm_datetime, host, unit, message, …) to the event
    # root so they land as structured, queryable fields instead of a text blob.
    #
    # Gate (#1220): only parse bodies that look like a JSON object. The fleet's plain-text
    # journal lines (systemd unit messages, cron/pam, OpenSearch's `[ts][LEVEL]` lines) are
    # not JSON; ungated, each one hit the invalid-JSON path and logged an ERROR (~447/min
    # on obs, ~2 cores of DP CPU). Those now pass through unparsed, indexed as before.
    # Every body that parsed before starts with `{` (the parser only accepts an object),
    # so JSON events are indexed exactly as they were.
    # Anything that starts with `{` but still fails is a real anomaly: it is tagged
    # `_jsonparsefailure`, counted in DP's parseErrors metric, and still logged (skip,
    # not skip_silently), so failures stay loud.
    # Options verified present in the shipped 2.16.0 ParseJsonProcessorConfig; see
    # https://docs.opensearch.org/latest/data-prepper/pipelines/configuration/processors/parse-json/
    - parse_json:
        source: "{{ data_prepper_parse_json_source }}"
        parse_when: 'startsWith(/{{ data_prepper_parse_json_source }}, "{")'
        tags_on_failure: ["_jsonparsefailure"]
        handle_failed_events: skip
  sink:
    # v1 OpenSearch runs security DISABLED (#827) — plain http on :9200, no auth. Writes the
    # daily logs-YYYY.MM.DD indices governed by the #827 index template (number_of_replicas:0),
    # which the site play (#832) ensures exists before this sink first writes.
    - opensearch:
        hosts: {{ data_prepper_opensearch_hosts | to_json }}
        insecure: true
        index: "{{ data_prepper_index }}"
        # Dead-letter queue (#1239): documents OpenSearch rejects are appended here
        # instead of being dropped with a WARN. Local file on obs, bounded by the
        # role's logrotate rule (size cap + copytruncate, because DP holds the file
        # open and never reopens it). Read/replay: docs/reference/data-prepper-dlq.md.
        dlq_file: "{{ data_prepper_dlq_file }}"
