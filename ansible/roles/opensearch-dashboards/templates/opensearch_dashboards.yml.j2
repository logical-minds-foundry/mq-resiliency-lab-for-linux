# Managed by ansible/roles/opensearch-dashboards (logsearch tier, epic .github#149). Static
# config, baked into the box; the service enable+start lives in the configure half.
server.host: "{{ opensearch_dashboards_server_host }}"
server.port: {{ opensearch_dashboards_server_port }}
opensearch.hosts: {{ opensearch_dashboards_opensearch_hosts }}

# Nested-virt migration/timeout hardening (#1180, epic .github#267). The default 30 s
# opensearch.requestTimeout fired mid saved-objects migration under arm64-on-macOS slowness
# (#249), half-creating `.kibana_1` and deadlocking. Raise the client + shard request timeouts
# and widen the migration scroll keepalive so the migration completes. See the role defaults
# and docs/reports/2026-09-28-obs-coexistence-jvm-budget.md. (OSD has no migrations.retryAttempts.)
opensearch.requestTimeout: {{ opensearch_dashboards_request_timeout_ms }}
opensearch.shardTimeout: {{ opensearch_dashboards_shard_timeout_ms }}
migrations.scrollDuration: "{{ opensearch_dashboards_migrations_scroll_duration }}"

{% if opensearch_dashboards_security_enabled | bool %}
# security-on posture (follow-on #819): authenticate to OpenSearch with the admin seam.
# NOTE: enabling this baked path with a real credential requires moving the secret to a
# per-run drop-in (never bake a secret) — see the configure half. Off in v1.
opensearch.username: "{{ opensearch_dashboards_opensearch_username | default('') }}"
opensearch.password: "{{ opensearch_dashboards_opensearch_password | default('') }}"
opensearch.ssl.verificationMode: none
{% else %}
# v1 telemetry-plane posture (spec §10, #827): OpenSearch runs `plugins.security.disabled`,
# so Dashboards connects over plain http with NO auth and its bundled security plugin removed
# (install half). Deliberately no opensearch_security.* / opensearch.username lines — writing
# auth/TLS the OpenSearch side is not running makes Dashboards fail to start.
{% endif %}
