{# lab-nativeha-state.service — render the Native HA textfiles once per tick. Type=oneshot
   with two ExecStart lines runs both collectors on the same fire (#810); each writes its
   own .prom (lab_nativeha_state.prom / lab_loglifecycle_state.prom). #}
[Unit]
Description=Render lab_nativeha_state + lab_loglifecycle_state textfiles (Native HA / CRR)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/lab-nativeha-state --qm {{ nativeha_qm | default('NHARAPP') }}
ExecStart=/usr/bin/python3 /usr/local/bin/lab-loglifecycle-state --qm {{ nativeha_qm | default('NHARAPP') }}
