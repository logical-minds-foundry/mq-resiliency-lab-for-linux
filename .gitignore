# Brainstorming visual-companion scratch
.superpowers/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local env / secrets — never commit IBM MQ entitlement or license artifacts
*.env
.env.local
secrets/
licenses/

# Vagrant / VM provisioning state (refined once the fabric design lands)
.vagrant/
*.box
*.log

# Ephemeral lab working tree — nested-VM images, vagrant boxes, libvirt disks.
# The dev VM mounts this; nothing here is precious or version-controlled.
# Ignore contents but keep the dir present in fresh clones via .gitkeep.
build/*
!build/.gitkeep

# Vergil global scratch — nothing source-controlled lives here.
.vergil/

# Vergil worktree convention — parallel-agent issue worktrees and host venv.
.worktrees/
.venv-host/

# Test/coverage artifacts
.coverage

# Python bytecode
__pycache__/
*.pyc

# Staged/generated docs artifacts — vrg-docs-stage copies the root
# CHANGELOG.md/releases sources here and mkdocs builds into site/. The
# sources (CHANGELOG.md, releases/) are committed; these copies are
# regenerated on every build.
docs/site/site/
docs/site/docs/changelog.md
docs/site/docs/releases/
